# ---------------------------------------------------------------------------
# Adaptive Evidence AI Lab — environment template (spec section 81)
#
# Copy to `.env` at the repository root. `.env` is git-ignored and is the single
# source of truth for both docker-compose and local backend runs.
# NEVER commit real credentials. Provider keys must never reach the browser.
# ---------------------------------------------------------------------------

# --- application ---
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json  (use json in production)
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- database ---
# Host port defaults to 5433 so it does not collide with a local Postgres.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://aelab:aelab@localhost:5433/aelab
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# --- cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- model providers ---
# Only keys for implemented providers appear here (spec section 81).
# Leaving this empty disables embedding; ingestion still parses and chunks.
MISTRAL_API_KEY=

# --- retrieval ---
VECTOR_STORE_BACKEND=pgvector      # pgvector | qdrant
KEYWORD_BACKEND=postgres_fts       # postgres_fts | bm25
# mistral-embed emits fixed 1024-dim vectors; this must match the
# chunks.embedding column, so changing it requires a migration.
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024

# --- object storage ---
# Local filesystem only for now; S3 and Azure are not implemented.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=aelab-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_LOCAL_PATH=./.data/objects

# --- api ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
